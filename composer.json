{
  "name": "doppar/insight",
  "description": "Doppar/Insight is a developer profiling and debugging toolbar for Doppar framework",
  "keywords": ["doppar", "profiler", "debugbar", "debug", "toolbar"],
  "homepage": "https://doppar.com/versions/3.x/doppar-insight.html",
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/doppar/insight/issues",
    "source": "https://github.com/doppar/insight"
  },
  "authors": [
        {
            "name": "Pierre Svgnt"
        }
    ],
  "autoload": {
    "psr-4": {
      "Doppar\\Insight\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1",
    "doppar/framework": "^2.9"
  },
  "extra": {
    "doppar": {
      "providers": [
        "Doppar\\Insight\\ProfilerServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload-dev": {
    "psr-4": {
      "Doppar\\Insight\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.89",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.4"
  },
  "scripts": {
    "phpstan": "phpstan analyse --level=8 --memory-limit=2G",
    "cs-fix": "php-cs-fixer fix",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "test": "phpunit",
    "analyse": [
      "@phpstan",
      "@cs-check"
    ]
  }
}
